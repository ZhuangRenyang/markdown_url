# ---------- 抓取模式（可选，默认 auto）----------
# auto    ：先用普通 HTTP 请求；正文少于 200 字符（疑似 JS 渲染空壳）才用浏览器
# plain   ：只用普通 HTTP 请求，不需要任何浏览器后端，也就不用部署 Cloudflare Worker
# browser ：只用浏览器渲染抓取（兼容性最好，最耗资源）
FETCH_MODE=auto

# auto 模式下的回退阈值（字符数）与请求超时（毫秒），一般不用改
# MIN_MARKDOWN_LENGTH=200
# FETCH_TIMEOUT_MS=15000

# ---------- 浏览器后端（只有 auto 回退或 browser 模式才需要）----------

# Cloudflare Worker 地址（用 Browser Rendering API 渲染网页）
# 例：HTMLFETCH_API=https://markdownworker.<你的子域>.workers.dev
HTMLFETCH_API=

# 备选：Browserless 远程浏览器（需在 browserless.io 注册获取）
BROWSERLESS_KEY=

# ---------- GPT 功能（可选）----------
# 勾选「用 GPT 处理 Markdown」时才需要
OPENAI_API_KEY=

# ---------- 站点信息（可选）----------
# 用于生成 OG 分享卡片等绝对链接，填你自己的 Vercel 域名，结尾不要带斜杠
# 例：NEXT_PUBLIC_SITE_URL=https://markdown-url.vercel.app
NEXT_PUBLIC_SITE_URL=
