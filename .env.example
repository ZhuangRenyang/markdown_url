# ---------- 抓取模式 ----------
# plain   ：只用普通 HTTP 请求，不需要任何浏览器后端（默认，推荐）
# auto    ：先用普通 HTTP 请求，正文少于 200 字符（疑似 JS 渲染空壳）才用浏览器
# browser ：只用浏览器渲染抓取，需要 BROWSERLESS_KEY 或容器里装了 Chromium
FETCH_MODE=plain

# 抓取相关的可调项，一般不用改
# MIN_MARKDOWN_LENGTH=200      auto 模式下判定「正文太短」的阈值
# FETCH_TIMEOUT_MS=15000       抓网页的超时
# IMG_FETCH_TIMEOUT_MS=15000   单张图片下载超时
# MAX_IMAGE_BYTES=10485760     单张图片大小上限（默认 10MB）

# ---------- AI 处理（可选）----------
# 勾选「用 AI 处理 Markdown」时才需要。支持 OpenAI 官方或任何 OpenAI 兼容中转站。
OPENAI_API_KEY=
# 用中转站时填这个（OpenAI 官方则留空）
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
# 模型名，中转站上实测可用：agnes-3.0-flash / agnes-2.5-flash / agnes-2.0-flash
OPENAI_MODEL=agnes-3.0-flash
# 勾选「使用更强的模型」时用的模型
OPENAI_MODEL_BIG=agnes-3.0-flash

# ---------- 浏览器后端（只有 auto/browser 模式才需要）----------
# 远程浏览器，需在 browserless.io 注册获取
BROWSERLESS_KEY=

# ---------- 站点信息（可选）----------
# 用于生成 OG 分享卡片等绝对链接，填你自己的域名，结尾不要带斜杠
# 例：NEXT_PUBLIC_SITE_URL=https://markdown-url.vercel.app
NEXT_PUBLIC_SITE_URL=
